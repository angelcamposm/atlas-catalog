# Atlas Catalog Frontend - Local environment variables
# Copy this file to `.env.local` and adjust values as needed:
#   cp .env.local.example .env.local

# URL base de la API del backend Laravel (sin slash final)
# - Si arrancas el backend con docker compose -f docker-compose.full.yml: http://localhost:8080/api
# - Si arrancas el backend en local con `php artisan serve`: http://localhost:8000/api
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Timeout (ms) para las peticiones HTTP del cliente API
NEXT_PUBLIC_API_TIMEOUT=30000
